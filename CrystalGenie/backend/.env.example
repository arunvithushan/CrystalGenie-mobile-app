# Copy to backend/.env and adjust. NEVER commit the real .env file.

# --- general
# APP_ENV: development | production | test
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api

# --- database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://crystal:crystal_dev_password@localhost:5432/crystal_genie
# Used only by the test-suite (a separate database that the tests may wipe)
TEST_DATABASE_URL=postgresql+psycopg://crystal:crystal_dev_password@localhost:5432/crystal_genie_test

# --- security
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=20
# In development the forgot-password response includes the reset code so you can test on a phone
# without configuring e-mail. This is forced OFF when APP_ENV=production.
EXPOSE_RESET_CODE_IN_RESPONSE=true

# --- CORS (comma separated). Mobile apps do not need CORS; this is for browser tools.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- uploads
MEDIA_ROOT=./var/media
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000

# --- machine learning model
MODEL_DIR=../models
MODEL_FILE=gemstone_model.keras
# Leave empty to use the threshold chosen by evaluate.py (model_metadata.json)
CONFIDENCE_THRESHOLD=

# --- e-mail (optional). If SMTP_HOST is empty, reset e-mails are written to var/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crystal Genie <no-reply@crystalgenie.local>
SMTP_STARTTLS=true

# "Browse this computer" in the app (development only, never in production)
PC_BROWSE_ENABLED=false
# ;-separated folders; empty = your user folder + other drives
PC_BROWSE_ROOTS=
# true = a phone on your Wi-Fi may browse too (default: only the emulator on this PC)
PC_BROWSE_ALLOW_LAN=false
